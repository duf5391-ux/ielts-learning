idebar\" id=\"workspace-navigation\"><div class=\"as-sidebar-scroll\"><a class=\"brand\" href=\"#study\"><span class=\"brand-mark\">i.</span><span class=\"brand-type\">IELTS<span>我的备考工作区</span></span></a><div class=\"px-more-heading\"><strong>更多</strong><button aria-label=\"关闭更多菜单\" id=\"px-more-close\" type=\"button\">关闭</button></div><nav aria-label=\"主导航\"><button data-go=\"study\" type=\"button\"><svg aria-hidden=\"true\" class=\"ui-icon\" viewbox=\"0 0 24 24\"><path d=\"M4 4h6a3 3 0 0 1 3 3v14a4 4 0 0 0-4-2H4zM13 7a3 3 0 0 1 3-3h4v15h-3a4 4 0 0 0-4 2\"></path></svg><span>学习库</span></button><button data-go=\"vocabulary-review\" type=\"button\"><svg aria-hidden=\"true\" class=\"ui-icon\" viewbox=\"0 0 24 24\"><rect height=\"18\" rx=\"4\" width=\"18\" x=\"3\" y=\"3\"></rect><path d=\"m7 16 4-9 4 9M8.5 13h5M17 8v8\"></path></svg><span>单词</span></button><button data-go=\"practice\" type=\"button\"><svg aria-hidden=\"true\" class=\"ui-icon\" viewbox=\"0 0 24 24\"><path d=\"m14 4 6 6-11 11H3v-6zM11 7l6 6M15 3l2-2 6 6-2 2\"></path></svg><span>专项练习</span></button><button data-go=\"tests\" type=\"button\"><svg aria-hidden=\"true\" class=\"ui-icon\" viewbox=\"0 0 24 24\"><rect height=\"17\" rx=\"3\" width=\"14\" x=\"5\" y=\"4\"></rect><path d=\"M9 4V2h6v2M9 12l2 2 4-5M9 18h6\"></path></svg><span>模拟</span></button><button data-go=\"writing-workbench\" type=\"button\"><svg aria-hidden=\"true\" class=\"ui-icon\" viewbox=\"0 0 24 24\"><path d=\"M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M15 3l6 6M14 3v7h7M8 14h7M8 17h5\"></path></svg><span>写作训练</span></button><button data-go=\"workspace\" type=\"button\"><svg aria-hidden=\"true\" class=\"ui-icon\" viewbox=\"0 0 24 24\"><path d=\"M3 7h7l2-3h9v15a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM3 7V5a2 2 0 0 1 2-2h4\"></path></svg><span>资料与记录</span></button></nav><div id=\"cal-desktop-host\"><section aria-label=\"学习历史与工作量\" class=\"usage-calendar\" id=\"study-calendar\">\r\n<header class=\"cal-heading\"><strong>学习记录</strong><span id=\"cal-period\">近 7 日</span><div class=\"cal-switch\"><button aria-label=\"前七天\" id=\"cal-prev\" type=\"button\">‹</button><button id=\"cal-today\" type=\"button\">今天</button><button aria-label=\"后七天\" id=\"cal-next\" type=\"button\">›</button></div></header>\r\n<div aria-label=\"按日期回看学习记录\" class=\"cal-grid\" id=\"cal-grid\" role=\"group\"></div>\r\n<div class=\"cal-selected\"><span id=\"cal-day-title\">今天</span><span id=\"cal-duration\"></span></div>\r\n<div class=\"cal-stats\" id=\"cal-stats\"></div>\r\n<div aria-label=\"当天学习内容\" class=\"cal-activity-list\" id=\"cal-activity-list\"></div>\r\n<p hidden=\"\" id=\"cal-error\" role=\"status\"></p>\r\n<p class=\"cal-note\">仅统计已保存的记录</p>\r\n</section>\r\n</div><div class=\"sidebar-goal\"><p>按自己的节奏学习。</p></div></div><div class=\"sidebar-foot account-settings-footer\"><span class=\"status-dot\" hidden=\"\"></span><span hidden=\"\">本地学习 · 第一册</span><button aria-controls=\"account-settings-dialog\" aria-haspopup=\"dialog\" class=\"as-account-entry\" id=\"as-sidebar-entry\" type=\"button\"><span aria-hidden=\"true\" class=\"as-avatar\">学</span><span class=\"as-entry-copy\"><strong id=\"as-entry-name\">本地学习者</strong><small id=\"as-entry-detail\">账号与设置</small></span><span aria-hidden=\"true\" class=\"as-entry-menu\">···</span></button></div></aside><header class=\"workspace-topbar ui-only\"><button aria-controls=\"workspace-navigation\" aria-expanded=\"false\" aria-label=\"打开导航\" class=\"mobile-menu\" id=\"mobile-menu\">☰</button><div class=\"breadcrumb\"><span>我的工作区</span><i>/</i><strong id=\"current-page-label\">学习首页</strong></div><div class=\"topbar-actions\"><span class=\"save-indicator\"><i></i><span id=\"save-status\" role=\"status\">文字保存在当前浏览器</span><button id=\"lookup-open\" title=\"点击英文词直接查词；图片中的词可手动输入\" type=\"button\">查词</button></span><a class=\"records-link\" hidden=\"\" href=\"#records\">我的记录 <svg aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\"><path d=\"M4 12h15m-6-6 6 6-6 6\"></path></svg></a><span id=\"beta-account-slot\"><button aria-controls=\"account-settings-dialog\" aria-haspopup=\"dialog\" aria-label=\"打开设置\" class=\"beta-account-button as-mobile-entry\" id=\"as-mobile-entry\" type=\"button\">设置</button></span></div></header><div class=\"cal-mobile-host\" id=\"cal-mobile-host\"></div><button aria-label=\"关闭导航\" class=\"nav-scrim ui-only\" hidden=\"\"></button><main><!--ielts-progressive-anchor-1--></main><aside aria-labelledby=\"lookup-heading\" aria-modal=\"false\" hidden=\"\" id=\"word-lookup\" role=\"dialog\">\r\n<div class=\"lookup-top\"><h2 id=\"lookup-heading\">生词注释</h2><button aria-label=\"关闭生词注释\" id=\"lookup-close\" type=\"button\">×</button></div>\r\n<form id=\"lookup-form\"><input aria-label=\"要查询的英文词或词组\" id=\"lookup-input\" maxlength=\"80\" placeholder=\"输入英文词或短词组\"/><button type=\"submit\">查询</button></form>\r\n<div aria-live=\"polite\" id=\"lookup-result\"><p>点击正文英文词即可查看注释；也可以在上面输入。</p></div>\r\n<p class=\"lookup-muted\">查过或学过的词会自动进入复习；收藏只标记重点。释义与原句保存在当前浏览器。</p><a class=\"lookup-dictionary\" href=\"#lookup-learning\">查看查词与学习历史 →</a></aside><!--LEARNING-UPGRADE:sentence-popup--><div aria-label=\"选中文字的操作\" class=\"st-toolbar\" hidden=\"\" id=\"selection-toolbar\" role=\"toolbar\">\r\n<span id=\"selection-preview\"></span><div class=\"st-actions\"><button id=\"selection-lookup\" type=\"button\">查词</button><button id=\"selection-collect\" type=\"button\">☆ 收藏单词</button><button id=\"selection-translate\" type=\"button\">翻译句子 · 联网</button><button aria-label=\"收起选择工具\" id=\"selection-dismiss\" type=\"button\">×</button></div>\r\n</div>\r\n<aside aria-labelledby=\"sentence-heading\" aria-modal=\"false\" class=\"st-popup\" hidden=\"\" id=\"sentence-popup\" role=\"dialog\">\r\n<div class=\"st-heading\"><h2 id=\"sentence-heading\">句子翻译</h2><button aria-label=\"关闭句子翻译\" id=\"sentence-close\" type=\"button\">×</button></div>\r\n<label>原句<textarea id=\"sentence-source\" maxlength=\"3000\" placeholder=\"选中正文中的句子，或在这里输入。\" rows=\"4\"></textarea></label>\r\n<div class=\"st-actions\"><label>方向<select id=\"sentence-direction\"><option value=\"en|zh-CN\">英文 → 中文</option><option value=\"zh-CN|en\">中文 → 英文</option></select></label><button id=\"sentence-translate\" type=\"button\">联网翻译</button></div>\r\n<p class=\"st-muted\">MyMemory 在线翻译，只发送上方原句。每次最多 500 字节（约 80 个英文词）；译文供理解参考，可自行修订。</p>\r\n<p aria-live=\"polite\" id=\"sentence-status\" role=\"status\"></p>\r\n<label>译文<textarea id=\"sentence-result\" maxlength=\"6000\" placeholder=\"译文会显示在这里，也可以输入自己的翻译。\" rows=\"4\"></textarea></label>\r\n<div class=\"st-actions\"><button id=\"sentence-save\" type=\"button\">☆ 收藏句子</button><a href=\"#sentence-learning\" id=\"sentence-notebook-link\">打开句子本 →</a></div>\r\n<div class=\"st-external\"><a id=\"sentence-bing\" rel=\"noopener noreferrer\" target=\"_blank\">在必应翻译中打开 ↗</a></div>\r\n</aside>\r\n<!--/LEARNING-UPGRADE:sentence-popup--><div class=\"toast\" hidden=\"\" id=\"toast\" role=\"status\"></div><!--ielts-progressive-script-8--><!--ielts-progressive-script-9--><!--ielts-progressive-script-10-->\r\n<!--ielts-progressive-script-11-->\r\n<!--ielts-progressive-script-12-->\r\n<!--ielts-progressive-script-13--><!--ielts-progressive-script-14--><!--ielts-progressive-script-15--><!--ielts-progressive-script-16--><!--ielts-progressive-script-17-->"}]