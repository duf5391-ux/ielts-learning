se-bar-height,52px) + 12px)}\r\nhtml.exercise-fullscreen body{margin:0!important;padding-top:0!important}\r\nhtml.exercise-fullscreen :is(#workspace-navigation,.workspace-topbar,#cal-mobile-host,#product-mobile-nav,.nav-scrim){display:none!important}\r\nhtml.exercise-fullscreen body main{margin:0!important;width:100%!important;max-width:none!important;box-sizing:border-box;padding:calc(var(--exercise-bar-height,52px) + 14px) max(16px,env(safe-area-inset-right)) 90px max(16px,env(safe-area-inset-left))!important}\r\nhtml.exercise-fullscreen body main>.panel{width:100%;max-width:none!important;box-sizing:border-box}\r\nhtml.exercise-fullscreen #exercise-screen-bar{position:fixed;top:0;left:0;right:0;min-height:52px;margin:0;padding:calc(6px + env(safe-area-inset-top)) max(16px,env(safe-area-inset-right)) 6px max(16px,env(safe-area-inset-left));background:#fbfcf6f5;border-bottom:1px solid #dbe5d6;box-shadow:0 2px 12px #243c2a06}\r\nhtml.exercise-fullscreen #exercise-screen-bar .exercise-screen-copy{display:flex;align-items:baseline;gap:20px}\r\n#exercise-screen-title{font-size:14px;color:#304f39;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#exercise-screen-status{font-size:11px;color:#61735d;overflow-wrap:anywhere}\r\nhtml.exercise-fullscreen{--flow-reading-top:var(--exercise-bar-height,52px)!important;--wex-top:var(--exercise-bar-height,52px)!important;--px-topbar:var(--exercise-bar-height,52px)!important}\r\nhtml.exercise-fullscreen :is(.ds-dock,#energy-reminder){bottom:max(8px,env(safe-area-inset-bottom))!important}\r\nhtml.exercise-fullscreen .ds-dock{left:50%!important;width:min(980px,calc(100vw - 24px))!important}\r\nhtml.exercise-fullscreen body.ds-dock-active main{padding-bottom:calc(var(--hs-dock-space,180px) + 20px)!important}\r\nhtml.exercise-fullscreen body:not(.ds-dock-active) :is(#toast,.la-notice){bottom:max(16px,env(safe-area-inset-bottom))!important}\r\nhtml.exercise-fullscreen [data-flow-reading] .flow-reading-toolbar{top:var(--exercise-bar-height,52px)}\r\n@media(max-width:800px){\r\n #exercise-screen-bar{min-height:46px;margin-bottom:6px}\r\n #exercise-screen-toggle{min-height:42px;font-size:12px;padding:8px 10px!important}\r\n html.exercise-fullscreen body main{padding-right:max(10px,env(safe-area-inset-right))!important;padding-left:max(10px,env(safe-area-inset-left))!important}\r\n html.exercise-fullscreen #exercise-screen-bar{gap:8px;padding-right:max(10px,env(safe-area-inset-right));padding-left:max(10px,env(safe-area-inset-left))}\r\n html.exercise-fullscreen #exercise-screen-bar .exercise-screen-copy{display:block}\r\n #exercise-screen-title{display:block;font-size:12px}\r\n #exercise-screen-status{display:block;font-size:10px;line-height:1.3;max-height:2.6em;overflow:auto}\r\n}\r\n@media print{#exercise-screen-bar{display:none!important}html.exercise-fullscreen body main{padding:0!important}}\r\n\r\n</style>\r\n<!--ielts-progressive-script-64-->\r\n<!-- /EXERCISE-FULLSCREEN-V1 -->\r\n<style id=\"reading-bank-style\">.rb-entry{padding:20px;background:#f0f5ed;border:1px solid #bfd0bd;border-radius:12px;margin:16px 0}.rb-entry h2{margin:0 0 8px}.rb-entry>a{display:inline-block;font-weight:700;padding:10px 16px;background:#285b42;color:white;border-radius:7px}.rb-filters{display:flex;flex-wrap:wrap;gap:10px;margin:20px 0}.rb-filters label{display:flex;flex-direction:column;gap:4px}.rb-filters label:first-child{flex:1}.rb-filters input,.rb-filters select{font:inherit;padding:10px;border:1px solid #bbc9bd;border-radius:6px;min-width:0}.rb-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.rb-list>a{color:inherit;text-decoration:none;padding:18px;border:1px solid #d9e0d6;border-radius:10px;background:white}.rb-list>a:hover{border-color:#558265;background:#f4f8f0}.rb-list strong{display:block;font-size:18px}.rb-list span,.rb-list small{display:block;margin-top:7px}.rb-list small{color:#586b60}.rb-list [hidden]{display:none}.rb-cambridge{border-left:5px solid #39734e!impo