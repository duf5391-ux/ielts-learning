ry:focus-visible,.mr-source-group>summary:focus-visible,.ds-reading-picker select:focus-visible{outline:2px solid #315e4f;outline-offset:4px}\r\n\r\n</style><!--ielts-progressive-script-42--><!--/MATERIAL-READING-V1:assets--><!--FEATURE-FIXES-V1:vocabulary--><style id=\"vocabulary-quick-marks-style\">.vq-choices,.vr-quick-marks{display:flex;gap:6px;flex-wrap:wrap;margin:9px 0}\r\n\r\n.vq-choices{width:100%}\r\n\r\n.tv-card footer>label[hidden]{display:none!important}\r\n\r\n.vq-choices button,.vr-quick-marks button{min-height:44px;padding:8px 13px;border:1px solid #bccfbc;border-radius:8px;background:#fff;color:#264d3a;font:inherit;font-size:13px;cursor:pointer}\r\n\r\n.vq-choices button[aria-pressed=\"true\"],#vocabulary-review .vr-quick-marks button[aria-pressed=\"true\"]{background:#285540;color:#fff;border-color:#285540}\r\n\r\n.vq-choices button[data-vq-value=\"\"]{font-size:12px}\r\n\r\n.vq-choices button:disabled{opacity:.45;cursor:default}\r\n\r\n.vq-choices button:focus-visible{outline:3px solid #7f9f70;outline-offset:2px}\r\n\r\n.vq-notice{min-height:1.4em;font-size:13px;color:#365d45}\r\n\r\n.vr-meaning-details>summary{cursor:pointer;padding:9px 0;color:#345d46;font-size:14px}\r\n\r\n.vr-grade-note{grid-column:1/-1;font-size:12px;color:#596b51;margin:0}\r\n\r\n@media(max-width:600px){.vq-choices{gap:5px}.vq-choices button{padding:8px 10px}.vr-quick-marks button{flex:1}}\r\n\r\n</style><!--ielts-progressive-script-43--><!--/FEATURE-FIXES-V1:vocabulary--><nav aria-label=\"常用导航\" id=\"product-mobile-nav\"><a href=\"#study\"><svg aria-hidden=\"true\" class=\"ui-icon\" viewbox=\"0 0 24 24\"><path d=\"M4 4h6a3 3 0 0 1 3 3v14a4 4 0 0 0-4-2H4zM13 7a3 3 0 0 1 3-3h4v15h-3a4 4 0 0 0-4 2\"></path></svg><span>学习</span></a><a href=\"#vocabulary-review\"><svg aria-hidden=\"true\" class=\"ui-icon\" viewbox=\"0 0 24 24\"><rect height=\"18\" rx=\"4\" width=\"18\" x=\"3\" y=\"3\"></rect><path d=\"m7 16 4-9 4 9M8.5 13h5M17 8v8\"></path></svg><span>单词</span></a><a href=\"#pra