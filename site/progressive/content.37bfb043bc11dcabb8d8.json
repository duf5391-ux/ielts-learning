rder-bottom:1px solid #dbe5d6;box-shadow:0 2px 12px #243c2a06}\r\nhtml.exercise-fullscreen #exercise-screen-bar .exercise-screen-copy{display:flex;align-items:baseline;gap:20px}\r\n#exercise-screen-title{font-size:14px;color:#304f39;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\r\n#exercise-screen-status{font-size:11px;color:#61735d;overflow-wrap:anywhere}\r\nhtml.exercise-fullscreen{--flow-reading-top:var(--exercise-bar-height,52px)!important;--wex-top:var(--exercise-bar-height,52px)!important;--px-topbar:var(--exercise-bar-height,52px)!important}\r\nhtml.exercise-fullscreen :is(.ds-dock,#energy-reminder){bottom:max(8px,env(safe-area-inset-bottom))!important}\r\nhtml.exercise-fullscreen .ds-dock{left:50%!important;width:min(980px,calc(100vw - 24px))!important}\r\nhtml.exercise-fullscreen body.ds-dock-active main{padding-bottom:calc(var(--hs-dock-space,180px) + 20px)!important}\r\nhtml.exercise-fullscreen body:not(.ds-dock-active) :is(#toast,.la-notice){bottom:max(16px,env(safe-area-inset-bottom))!important}\r\nhtml.exercise-fullscreen [data-flow-reading] .flow-reading-toolbar{top:var(--exercise-bar-height,52px)}\r\n@media(max-width:800px){\r\n #exercise-screen-bar{min-height:46px;margin-bottom:6px}\r\n #exercise-screen-toggle{min-height:42px;font-size:12px;padding:8px 10px!important}\r\n html.exercise-fullscreen body main{padding-right:max(10px,env(safe-area-inset-right))!important;padding-left:max(10px,env(safe-area-inset-left))!important}\r\n html.exercise-fullscreen #exercise-screen-bar{gap:8px;padding-right:max(10px,env(safe-area-inset-right));padding-left:max(10px,env(safe-area-inset-left))}\r\n html.exercise-fullscreen #exercise-screen-bar .exercise-screen-copy{display:block}\r\n #exercise-screen-title{display:block;font-size:12px}\r\n #exercise-screen-status{display:block;font-size:10px;line-height:1.3;max-height:2.6em;overflow:auto}\r\n}\r\n@media print{#exercise-screen-bar{display:none!important}html.exercise-fullscreen body main{padding:0!imp