[{"target":"ielts-progressive-anchor-0","html":"<!--ielts-progressive-script-40--><!--/DAILY-STUDY-V1:scripts--><!--ielts-progressive-script-41-->\r\n<!--ielts-progressive-script-42-->\r\n<!--MATERIAL-READING-V1:assets--><style id=\"material-reading-style\">.material-reading,.material-writing{margin:24px 0;border-top:1px solid var(--line,#d9ded4);color:var(--ink,#22312e);scroll-margin-top:85px}\r\n\r\n.material-reading>summary,.mr-source-group>summary{padding:16px 0;cursor:pointer;font-weight:650;line-height:1.7}\r\n\r\n.mr-body{max-width:800px;padding:0 0 18px;line-height:1.95;overflow-wrap:anywhere}\r\n\r\n.mr-body h4,.material-writing h4{margin:22px 0 10px;color:var(--green,#204c42);line-height:1.65}\r\n\r\n.mr-body blockquote,.material-writing blockquote{margin:12px 0;padding:14px 18px;border-left:3px solid #91aea1;background:#f4f7f4;font:17px/1.9 Georgia,'Times New Roman',serif;color:#22312e;overflow-wrap:anywhere}\r\n\r\n.mr-body p,.material-writing p{line-height:1.9;margin:10px 0}.mr-overview{font-size:16px}\r\n\r\n.mr-paragraph,.mr-sentence{padding-bottom:16px}.mr-phrase{padding:14px 0;border-bottom:1px solid #e3e9e3}\r\n\r\n.mr-phrase>strong{font:600 17px/1.7 Georgia,'Times New Roman',serif}.mr-example-label{font-size:12px;color:var(--muted,#65726c)}\r\n\r\n.mr-source-group{border-bottom:1px solid #d9ded4}.material-writing{padding:12px 0 20px}.material-writing[hidden],.mr-source-group[hidden]{display:none!important}\r\n\r\n.ds-reading-picker{flex-basis:100%;display:flex;flex-direction:column;gap:8px;margin-top:10px;font-size:12px}.ds-reading-picker select{width:100%;max-width:100%;min-height:42px;padding:8px;border:1px solid #b9c9bf;border-radius:5px;background:#fff;color:#22312e;font:inherit}\r\n\r\n@media(max-width:520px){.mr-body blockquote,.material-writing blockquote{padding:12px;font-size:16px}.mr-body{font-size:15px}.material-writing h3{font-size:18px}}\r\n\r\n.material-reading>summary:focus-visible,.mr-source-group>summary:focus-visible,.ds-reading-picker select:focus-visible{outline:2px solid #315e4f;outline-offset:4px}\r\n\r\n/* Personal material editor: original form and preview share one workspace. */\r\n#materials .workspace-heading{margin:0 0 16px;padding:0}\r\n#materials .workspace-heading h1{font-size:26px;margin:0 0 5px}\r\n#materials .workspace-heading p{margin:0;font-size:14px}\r\n#materials .workspace-heading .ui-kicker{display:none}\r\n#materials[data-material-view=reader]>.workspace-heading{display:none}\r\n#materials .material-import-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px 22px;align-items:start}\r\n#materials .material-editor-heading{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:16px;margin:0}\r\n#materials .material-editor-heading h2{margin:0;font-size:18px}\r\n#materials .material-editor-meta{grid-column:1/-1;display:grid;grid-template-columns:minmax(0,2fr) minmax(140px,1fr) minmax(0,1fr);gap:12px}\r\n#materials .material-form,#materials .material-preview{padding:0;border:0;border-radius:0;background:transparent;min-width:0}\r\n#materials .material-preview{position:static;border-left:1px solid var(--line,#d9ded4);padding-left:22px}\r\n#materials .material-preview h2{font-size:16px;margin:0 0 10px}\r\n#materials .material-form label,#materials .material-editor-meta label{display:block;margin:0;color:var(--muted,#65726c);font-size:12px;min-width:0}\r\n#materials .material-form :is(input:not([type=file]),select,textarea),#materials .material-editor-meta :is(input,select){display:block;box-sizing:border-box;width:100%;min-width:0;margin:5px 0 0;padding:9px 11px;min-height:42px;border:1px solid var(--line,#cbd7cb);border-radius:5px;background:var(--paper,#fffefa);color:var(--ink,#22312e);font-family:inherit;font-size:15px;line-height:1.5}\r\n#materials .material-form input::placeholder,#materials .material-form textarea::placeholder,#materials .material-editor-meta input::placeholder{font-size:13px;color:var(--muted,#65726c)}\r\n#materials .material-content-field textarea{height:430px;min-height:340px;resize:vertical;font:16px/1.75 Arial,'Microsoft YaHei',sans-serif}\r\n#materials .material-form-actions{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:12px 0 0}\r\n#materials .material-form-actions button,#materials .material-preview button{min-height:42px;font-size:14px;padding:9px 16px}\r\n#materials .material-preview p,#materials .material-preview li{font-size:13px;line-height:1.7;color:var(--muted,#65726c)}\r\n#materials .material-preview .primary{width:100%;margin:12px 0 0}\r\n#materials .material-preview .small{font-size:12px;margin:10px 0}\r\n#materials .material-preview-item{padding:14px;margin:10px 0;border:1px solid var(--line,#d9ded4);border-radius:6px;background:var(--paper,#fffefa);max-height:430px;overflow:auto}\r\n#materials .material-preview-item h3{font-size:18px;margin:0 0 8px;overflow-wrap:anywhere}\r\n#materials .material-preview-item pre{white-space:pre-wrap;overflow-wrap:anywhere;font:15px/1.8 Arial,'Microsoft YaHei',sans-serif;margin:10px 0 0;color:var(--ink,#22312e)}\r\n#materials .material-message{font-size:13px;line-height:1.6;min-height:20px;margin:10px 0;color:var(--muted,#65726c)}\r\n#materials .material-format-options{margin:14px 0 0;border-top:1px solid var(--line,#d9ded4);padding-top:10px;font-size:13px}\r\n#materials .material-format-options summary{cursor:pointer;color:var(--green,#204c42);padding:4px 0}\r\n#materials .material-format-options label{margin:12px 0}\r\n#materials .material-format-options .small,#materials .material-format-options .material-intake-boundary{font-size:12px;line-height:1.7;color:var(--muted,#65726c);background:transparent;margin:10px 0;padding:0}\r\n#materials .material-file-button{position:relative;display:inline-block;font-size:13px;border:1px solid var(--line,#cbd7cb);border-radius:5px;padding:9px 12px;margin:0;color:var(--green,#204c42);cursor:pointer;overflow:hidden;white-space:nowrap}\r\n#materials .material-file-button input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%}\r\n#materials .material-file-button:focus-within{outline:2px solid var(--green,#204c42);outline-offset:3px}\r\n#materials .my-materials{margin:30px 0 0;padding-top:20px;border-top:1px solid var(--line,#d9ded4)}\r\n#materials .my-materials .section-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:0 0 12px}\r\n#materials .my-materials h2{font-size:20px;margin:0}\r\n#materials .my-materials .ui-kicker{display:none}\r\n#materials .my-materials h2 span{font:inherit;color:var(--muted,#65726c);margin-left:8px}\r\n#materials .material-list-controls{display:flex;gap:12px;margin:0 0 14px}\r\n#materials .material-list-controls .filter-search{flex:1;min-width:0}\r\n#materials .material-list-controls select{min-width:0;max-width:45%;font-size:13px;padding:8px}\r\n#materials .added-material-card{border:0;border-bottom:1px solid var(--line,#d9ded4);border-radius:0;padding:16px 0;margin:0;background:transparent}\r\n#materials .added-material-card h3{font-size:17px}\r\n#materials .added-material-card p,#materials .added-material-card .added-material-snippet{font-size:13px;color:var(--muted,#65726c)}\r\n#materials .material-reader{padding:0;border:0;border-radius:0;background:transparent}\r\n#materials .material-reader-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;border-bottom:1px solid var(--line,#d9ded4);padding:0 0 12px;margin:0 0 18px}\r\n#materials .material-reader-toolbar>div{display:flex;gap:8px}\r\n#materials .material-reader-toolbar button{min-height:40px;font-size:13px}\r\n#materials .material-reader h2{font-size:26px;line-height:1.5;margin:0 0 8px;overflow-wrap:anywhere}\r\n#materials .material-reader .material-meta{font-size:13px;color:var(--muted,#65726c);margin:0 0 20px;overflow-wrap:anywhere}\r\n#materials .material-reader pre{white-space:pre-wrap;overflow-wrap:anywhere;font:17px/1.9 Arial,'Microsoft YaHei',sans-serif;color:var(--ink,#22312e);max-width:900px}\r\n@media(max-width:800px){#materials .material-import-layout{grid-template-columns:minmax(0,1fr)}#materials .material-editor-meta{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}#materials .material-editor-meta>label:first-child{grid-column:1/-1}#materials .material-preview{border:0;border-top:1px solid var(--line,#d9ded4);padding:16px 0 0}#materials .material-content-field textarea{height:340px;min-height:260px}#materials .material-reader h2{font-size:23px}#materials .material-reader pre{font-size:16px}#materials .material-reader-toolbar{flex-wrap:wrap}}\r\n</style><!--ielts-progressive-script-43--><!--/MATERIAL-READING-V1:assets--><!--FEATURE-FIXES-V1:vocabulary--><style id=\"vocabulary-quick-marks-style\">/* Vocabulary workspace: current sense, recall, source and existing use worksheet. */\r\n.word-tool-links,.ui-word-tabs{display:flex;flex-wrap:wrap;gap:4px;margin:0 0 18px;font-size:14px;border-bottom:1px solid var(--ui-line)}\r\n.ui-word-tabs a{display:inline-flex;align-items:center;min-height:42px;padding:9px 14px;text-decoration:none;color:var(--ui-accent)}\r\n.ui-word-tabs a[aria-current]{border-bottom:3px solid var(--ui-accent);font-weight:650}\r\n#vocabulary-review,#word-review{padding:0;border:0;background:none;border-radius:0}\r\n.ui-word-heading{margin:0 0 18px}.ui-word-heading h1{font-size:28px;margin:0 0 6px}.ui-word-heading .ui-subtitle{font-size:14px;line-height:1.6;margin:0 0 14px;color:var(--ui-muted,#617064)}\r\n.ui-wordlist-switch{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}\r\n.ui-wordlist-switch a{display:inline-flex;align-items:center;min-height:42px;padding:9px 14px;border:1px solid var(--ui-line);border-radius:7px;background:var(--ui-paper);color:var(--ui-accent);font-size:14px;text-decoration:none}\r\n.ui-wordlist-switch a[aria-current]{background:var(--ui-accent);border-color:var(--ui-accent);color:white}\r\n.ui-word-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;max-width:860px;margin:0 0 14px}\r\n.ui-word-toolbar label{display:flex;align-items:center;gap:10px;font-size:14px}.ui-word-toolbar select{font:inherit;font-size:14px;min-height:42px;min-width:160px;max-width:240px;padding:9px 12px;border:1px solid var(--ui-line);border-radius:7px;background:var(--ui-paper);color:var(--ui-ink)}\r\n.ui-word-count{font-size:13px;color:var(--ui-muted,#617064);margin:0}\r\n.ui-learn-card{max-width:860px;margin:0;padding:24px 30px;border:1px solid var(--ui-line);border-radius:12px;background:var(--ui-paper);box-shadow:none;overflow-wrap:anywhere}\r\n.ui-topic-pill{display:inline-block;padding:4px 9px;font-size:12px;background:var(--ui-soft);color:var(--ui-accent);border-radius:5px}\r\n.ui-learn-term{font-size:42px;line-height:1.2;font-weight:650;margin:18px 0 4px;color:var(--ui-ink);letter-spacing:-.02em}.ui-learn-pos{font:italic 14px Georgia,serif;color:var(--ui-muted,#617064)}\r\n.ui-learn-prompt{font-size:14px;line-height:1.6;color:var(--ui-muted,#617064);margin:16px 0}\r\n.ui-reveal,.pe-word-next,.ui-solid-link{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 16px;font:inherit;font-size:14px;border:1px solid var(--ui-accent);border-radius:7px;background:var(--ui-accent);color:white;cursor:pointer;text-decoration:none;margin:12px 0}\r\n.ui-learn-definition{margin:16px 0}.ui-learn-meaning{font-size:18px;line-height:1.6;font-weight:550;margin:8px 0;color:var(--ui-ink)}\r\n.ui-learn-definition blockquote{border-left:3px solid var(--ui-line);padding:2px 0 2px 16px;margin:12px 0;background:none}.ui-learn-definition blockquote p{font-size:14px;line-height:1.6;margin:5px 0;color:var(--ui-muted,#617064)}.ui-learn-definition blockquote [lang=en]{font-size:18px;line-height:1.6;font-family:Georgia,serif;color:var(--ui-ink)}\r\n.ui-word-use{display:inline-flex;align-items:center;min-height:40px;padding:8px 0;font-size:14px;font-weight:600;color:var(--ui-accent)}\r\n.ui-learn-grades{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:20px;padding-top:16px;border-top:1px solid var(--ui-line)}\r\n.ui-learn-grades button{min-height:60px;border:1px solid var(--ui-line);border-radius:7px;background:var(--ui-soft);color:var(--ui-accent);font:inherit;padding:10px;cursor:pointer}.ui-learn-grades strong{display:block;font-size:16px}.ui-learn-grades span{display:block;font-size:12px;margin-top:3px}.ui-learn-grades [data-learn-grade=known]{background:var(--ui-accent);color:white;border-color:var(--ui-accent)}\r\n.ui-learn-note{font-size:12px;line-height:1.6;color:var(--ui-muted,#617064);margin:12px 0 0}.ui-word-status{font-size:14px;line-height:1.6;margin:12px 0;max-width:860px}.ui-word-status:empty{display:none}.ui-learn-empty{padding:32px;text-align:center}.ui-learn-complete{font-size:32px;color:var(--ui-accent)}.pe-word-feedback{font-size:14px;color:var(--ui-accent);margin:12px 0}.pe-word-next{min-width:180px}.pe-word-next:disabled{opacity:.5;cursor:default}\r\n.ui-word-browse{display:flex;flex-wrap:wrap;gap:20px;margin:18px 0;font-size:14px}.ui-wordlist-about{border:0;border-top:1px solid var(--ui-line);background:none;padding:10px 0;margin:12px 0}.ui-wordlist-about>summary{cursor:pointer;font-size:13px;padding:8px 0;color:var(--ui-accent)}.ux-keyboard-note{font-size:12px;color:var(--ui-muted,#617064);margin:12px 0}\r\n#vocabulary-review :focus-visible,.ui-wordlist-switch a:focus-visible{outline:3px solid var(--ui-accent);outline-offset:3px}\r\n/* Recall marks and the existing personal word list remain separate evidence. */\r\n.vq-choices,.vr-quick-marks{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.vq-choices{width:100%}.vq-choices button,.vr-quick-marks button{min-height:42px;padding:8px 13px;border:1px solid var(--ui-line);border-radius:7px;background:var(--ui-paper);color:var(--ui-accent);font:inherit;font-size:13px;cursor:pointer}.vq-choices button[aria-pressed=true],.vr-quick-marks button[aria-pressed=true]{background:var(--ui-accent);color:white;border-color:var(--ui-accent)}.vq-choices button:disabled{opacity:.45;cursor:default}.vq-choices button:focus-visible{outline:3px solid var(--ui-accent);outline-offset:2px}.vq-notice{min-height:1.4em;font-size:13px;color:var(--ui-accent)}.vr-meaning-details>summary{cursor:pointer;padding:9px 0;color:var(--ui-accent);font-size:14px}.vr-grade-note{grid-column:1/-1;font-size:12px;color:var(--ui-muted,#617064);margin:0}\r\n#word-review button,#word-review input,#word-review select{border:1px solid var(--ui-line);border-radius:7px;padding:10px 13px;background:var(--ui-paper);color:var(--ui-accent);font:inherit;font-size:14px;max-width:100%;min-height:40px}#word-review button{cursor:pointer}#word-review button:disabled{opacity:.5;cursor:default}#word-review .vr-primary{background:var(--ui-accent);color:white;border-color:var(--ui-accent)}\r\n.vr-list{display:block}.vr-list-card{border:0;border-bottom:1px solid var(--ui-line);border-radius:0;padding:16px 0;background:none}.vr-card-heading{display:flex;flex-wrap:wrap;align-items:center;gap:10px}.vr-list-card h3{font-size:21px}.vr-list-tools,.vr-list-card .vr-controls{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin:12px 0}.vr-list-tools button,.vr-word-actions button{min-height:40px;border:1px solid var(--ui-line);border-radius:7px;padding:9px 13px;background:var(--ui-paper);color:var(--ui-accent);font:inherit;font-size:13px;cursor:pointer}.vr-list-tools button[aria-pressed=true],.vr-word-actions button[aria-pressed=true]{background:var(--ui-soft);border-color:var(--ui-accent)}.vr-word-actions button.vr-primary{background:var(--ui-accent);color:white}.vr-list-card :is(.vr-meaning-details,.vr-edit,.vr-legacy){margin:10px 0;border:0;border-top:1px solid var(--ui-line);background:none;padding:8px 0 0}.vr-list-card summary{cursor:pointer;min-height:36px;padding:6px 0;font-size:13px;color:var(--ui-accent)}.vr-list-card .vr-muted{font-size:13px;line-height:1.6}\r\n/* The original worksheet is 